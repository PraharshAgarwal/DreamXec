enum VaultDocumentType {
  GOVT_ID
  STUDENT_ID
  UNIVERSITY_ENDORSEMENT
  BANK_PASSBOOK
  INVOICE
  PROJECT_PROPOSAL
  ORGANIZATION_REGISTRATION
  OTHER

  @@schema("doc_vault")
}

model UserDocVault {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  documentType  VaultDocumentType @default(OTHER) @map("document_type")
  title         String            @db.VarChar(255)
  fileName      String            @map("file_name") @db.VarChar(255)
  fileUrl       String            @map("file_url") @db.VarChar(1000)
  fileSizeBytes BigInt            @default(0) @map("file_size_bytes")
  mimeType      String?           @map("mime_type") @db.VarChar(100)
  isVerified    Boolean           @default(false) @map("is_verified")
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz

  user          User              @relation("UserDocVaultItems", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_doc_vault")
  @@schema("doc_vault")
}

