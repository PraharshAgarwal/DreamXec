model GrantProposal {
  id              String    @id @default(uuid()) @db.Uuid
  grantId         String    @map("grant_id") @db.Uuid
  applicantOrgId  String    @map("applicant_org_id") @db.Uuid
  submittedBy     String    @map("submitted_by") @db.Uuid
  requestedAmount Decimal   @map("requested_amount") @db.Decimal(15, 2)
  status          String    @default("SUBMITTED") @db.VarChar(50)
  proposalData    Json      @default("{}") @map("proposal_data")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
