enum VaultAccountType {
  INDIVIDUAL_SAVINGS
  INDIVIDUAL_CURRENT
  INSTITUTIONAL_CURRENT
  STUDENT_CLUB

  @@schema("account_vault")
}

model UserAccountVault {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  accountNickname   String?          @map("account_nickname") @db.VarChar(100)
  accountHolderName String           @map("account_holder_name") @db.VarChar(255)
  bankAccountNumber String           @map("bank_account_number") @db.VarChar(100)
  ifscCode          String           @map("ifsc_code") @db.VarChar(50)
  bankName          String?          @map("bank_name") @db.VarChar(255)
  upiId             String?          @map("upi_id") @db.VarChar(150)
  accountType       VaultAccountType @default(INDIVIDUAL_SAVINGS) @map("account_type")
  isPrimary         Boolean          @default(false) @map("is_primary")
