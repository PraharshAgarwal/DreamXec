  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  status       JobStatus
  errorMessage String?   @map("error_message") @db.Text
  metadata     Json      @default("{}")

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_executions")
  @@schema("jobs")
}

// ============================================================================
// 13. STUDENT CAMPAIGNS DOMAIN SCHEMA (campaigns.*)
// ============================================================================

enum CampaignStatus {
  DRAFT
  SUBMITTED
  PENDING_ENDORSEMENT //professors,mentors
  PENDING_VERIFICATION
  LIVE
  PAUSED
  FULLY_FUNDED
  CLOSED
  CANCELLED
  REJECTED
  DISBURSING
  COMPLETED

  @@schema("campaigns")
}

enum CampaignCategory {
  TUITION_FEE
  RESEARCH_GRANT
  STARTUP_INNOVATION
  EMERGENCY_AID
  COMPETITION_TRAVEL
  EXTRACURRICULAR
  COMMUNITY_PROJECT
  CLUB_PROJECT

  @@schema("campaigns")
}

enum DisbursementType {
  MILESTONE_TRANCHE
  DIRECT_TUITION_PAYOUT
  REIMBURSEMENT

  @@schema("campaigns")
}

enum FundingModel {
  FLEXIBLE
  ALL_OR_NOTHING

  @@schema("campaigns")
}

enum ProjectStage {
  DISCOVERY
  FEASIBILITY
  PROTOTYPE
  PILOT
  COMMERCIALIZATION

  @@schema("campaigns")
}

enum EndorsementStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("campaigns")
}

enum CampaignMemberRole {
  OWNER
  MEMBER

  @@schema("campaigns")
}

model Campaign {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  studentUserId     String           @map("student_user_id") @db.Uuid
  beneficiaryUserId String?          @map("beneficiary_user_id") @db.Uuid
  organizationId    String?          @map("organization_id") @db.Uuid
  title             String           @db.VarChar(255)
  slug              String           @unique @db.VarChar(120)
  category          CampaignCategory
  campaignType      String           @default("INDIVIDUAL") @map("campaign_type") @db.VarChar(50)
  stage             ProjectStage     @default(DISCOVERY)

  shortDescription    String   @map("short_description") @db.VarChar(500)
  description         String   @db.Text
  coverImageUrl       String   @map("cover_image_url") @db.VarChar(500)
  galleryImageUrls    String[] @default([]) @map("gallery_image_urls")
  videoUrl            String?  @map("video_url") @db.VarChar(500)
  presentationDeckUrl String?  @map("presentation_deck_url") @db.VarChar(500)

  faqs               Json  @default("[]")
  teamMembers        Json  @default("[]") @map("team_members")
  beneficiaryDetails Json? @map("beneficiary_details")

  targetAmount        Decimal @map("target_amount") @db.Decimal(15, 2)
  minDonationAmount   Decimal @default(1.00) @map("min_donation_amount") @db.Decimal(15, 2)
  currentRaisedAmount Decimal @default(0.00) @map("current_raised_amount") @db.Decimal(15, 2)
  donorCount          Int     @default(0) @map("donor_count")
  currency            String  @default("INR") @db.VarChar(3)

  status CampaignStatus @default(DRAFT)

  // Governance & Verification Audit
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz
  rejectionReason  String?   @map("rejection_reason") @db.Text
  reapprovalCount  Int       @default(0) @map("reapproval_count")

  escrowAccountId String?   @unique @map("escrow_account_id") @db.Uuid
  startDate       DateTime? @map("start_date") @db.Timestamptz
  endDate         DateTime? @map("end_date") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant        Organization          @relation("TenantCampaigns", fields: [tenantId], references: [id], onDelete: Restrict)
  department    Organization?         @relation("DepartmentCampaigns", fields: [organizationId], references: [id], onDelete: SetNull)
  student       User                  @relation("StudentCampaigns", fields: [studentUserId], references: [id], onDelete: Cascade)
  beneficiary   User?                 @relation("BeneficiaryCampaigns", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  verifiedBy    User?                 @relation("VerifiedCampaigns", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  escrowAccount LedgerAccount?        @relation(fields: [escrowAccountId], references: [id], onDelete: SetNull)
  milestones    CampaignMilestone[]
  endorsements  CampaignEndorsement[]
  members       CampaignMember[]
  comments      CampaignComment[]
  donations     Donation[]

  @@index([tenantId, status])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([studentUserId, createdAt(sort: Desc)])
  @@index([category, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("campaigns")
  @@schema("campaigns")
}

model CampaignMilestone {
  id            String @id @default(uuid()) @db.Uuid
  campaignId    String @map("campaign_id") @db.Uuid
  sequenceOrder Int    @map("sequence_order")

  // Current Active State
  currentVersion Int       @default(1) @map("current_version")
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  durationDays   Int       @default(30) @map("duration_days")
  startDate      DateTime? @map("start_date") @db.Timestamptz
  deadline       DateTime? @db.Timestamptz
  targetAmount   Decimal   @map("target_amount") @db.Decimal(15, 2)
  releasedAmount Decimal   @default(0.00) @map("released_amount") @db.Decimal(15, 2)
  utilizedAmount Decimal   @default(0.00) @map("utilized_amount") @db.Decimal(15, 2)

  acceptanceCriteria    Json      @default("[]") @map("acceptance_criteria")
  requiredEvidenceTypes String[]  @default([]) @map("required_evidence_types")
  status                String    @default("PLANNED") @db.VarChar(50) // PLANNED, ACTIVE, SUBMITTED, UNDER_VERIFICATION, REVISION_REQUIRED, APPROVED, FUNDS_RELEASED, POST_DISBURSEMENT_PENDING, COMPLETED, DELAYED, SUSPENDED, REJECTED, CANCELLED
  disbursedAt           DateTime? @map("disbursed_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  campaign               Campaign                      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissions            CampaignMilestoneSubmission[]
  revisions              CampaignMilestoneRevision[]
  milestoneDisbursements MilestoneDisbursement[]

  @@unique([campaignId, sequenceOrder])
  @@index([campaignId])
  @@index([status])
  @@map("campaign_milestones")
  @@schema("campaigns")
}

model CampaignMilestoneSubmission {
  id                   String   @id @default(uuid()) @db.Uuid
  milestoneId          String   @map("milestone_id") @db.Uuid
  submissionNumber     Int      @default(1) @map("submission_number")
  submissionAttempt    Int      @default(1) @map("submission_attempt")
  narrative            String?  @db.Text
  evidenceDocId        String?  @map("evidence_doc_id") @db.Uuid
  evidenceMediaUrls    String[] @default([]) @map("evidence_media_urls")
  evidenceDocumentUrls String[] @default([]) @map("evidence_document_urls")
  criteriaChecklist    Json     @default("[]") @map("criteria_checklist")
  studentNotes         String?  @map("student_notes") @db.Text
  status               String   @default("PENDING_REVIEW") @db.VarChar(50) // PENDING_REVIEW, APPROVED, REJECTED

  // Reviewer Audit
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason  String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  milestone   CampaignMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  evidenceDoc Document?         @relation(fields: [evidenceDocId], references: [id], onDelete: Restrict)
  reviewedBy  User?             @relation("ReviewedMilestoneSubmissions", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([evidenceDocId])
  @@index([reviewedByUserId])
  @@map("campaign_milestone_submissions")
  @@schema("campaigns")
}

enum DisbursementStatus {
  PENDING_CHECKER
  AUTHORIZED
  PROCESSING
  SETTLED
  FAILED
  REVERSED

  @@schema("finance")
}

// ============================================================================
// WITHDRAWAL REQUEST (Student Payout to Bank Account)
// ============================================================================

enum WithdrawalStatus {
  REQUESTED     // Debit hold posted, payout about to initiate
  PROCESSING    // Razorpay payout API called
  SETTLED       // Razorpay confirmed delivery to bank
  FAILED        // Payout failed (funds released back)
  REVERSED      // Payout reversed after settlement
  CANCELLED     // Student cancelled before payout initiated

  @@schema("finance")
}

model WithdrawalRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  tenantId              String?           @map("tenant_id") @db.Uuid
  amount                Decimal           @db.Decimal(15, 2)
  currency              String            @default("INR") @db.VarChar(3)
  status                WithdrawalStatus  @default(REQUESTED)

  // Snapshot of bank account at request time
  vaultAccountId        String            @map("vault_account_id") @db.Uuid
  accountHolderName     String            @map("account_holder_name") @db.VarChar(255)
  bankAccountNumber     String            @map("bank_account_number") @db.VarChar(100)
  ifscCode              String            @map("ifsc_code") @db.VarChar(50)
  upiId                 String?           @map("upi_id") @db.VarChar(150)

  // Razorpay Payout tracking
  razorpayContactId     String?           @map("razorpay_contact_id") @db.VarChar(100)
  razorpayFundAccId     String?           @map("razorpay_fund_acc_id") @db.VarChar(100)
  razorpayPayoutId      String?           @map("razorpay_payout_id") @db.VarChar(100)

  // Ledger link
  reservationLedgerTxId String?           @map("reservation_ledger_tx_id") @db.Uuid
  settlementLedgerTxId  String?           @map("settlement_ledger_tx_id") @db.Uuid
  idempotencyKey        String            @unique @map("idempotency_key") @db.VarChar(255)
  failureReason         String?           @map("failure_reason") @db.Text

  // Timestamps
  requestedAt           DateTime          @default(now()) @map("requested_at") @db.Timestamptz
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz
  settledAt             DateTime?         @map("settled_at") @db.Timestamptz
  failedAt              DateTime?         @map("failed_at") @db.Timestamptz
  metadata              Json              @default("{}")

  user                  User              @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Restrict)
  organization          Organization?     @relation("TenantWithdrawals", fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, requestedAt(sort: Desc)])
  @@index([razorpayPayoutId])
  @@map("withdrawal_requests")
  @@schema("finance")
}

model MilestoneDisbursement {
  id              String             @id @default(uuid()) @db.Uuid
  milestoneId     String             @map("milestone_id") @db.Uuid
  amount          Decimal            @db.Decimal(15, 2)
  currency        String             @default("INR") @db.VarChar(3)
  status          DisbursementStatus @default(PENDING_CHECKER)
  makerUserId     String             @map("maker_user_id") @db.Uuid
  checkerUserId   String?            @map("checker_user_id") @db.Uuid
  payoutReference String?            @map("payout_reference") @db.VarChar(255)
  ledgerTxId      String?            @map("ledger_tx_id") @db.Uuid
  authorizedAt    DateTime?          @map("authorized_at") @db.Timestamptz
  settledAt       DateTime?          @map("settled_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  milestone         CampaignMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  makerUser         User               @relation("DisbursementMaker", fields: [makerUserId], references: [id], onDelete: Restrict)
  checkerUser       User?              @relation("DisbursementChecker", fields: [checkerUserId], references: [id], onDelete: SetNull)
  utilizationProofs UtilizationProof[]

  @@index([milestoneId])
  @@index([makerUserId])
  @@index([checkerUserId])
  @@map("milestone_disbursements")
  @@schema("finance")
}

model UtilizationProof {
  id               String    @id @default(uuid()) @db.Uuid
  disbursementId   String    @map("disbursement_id") @db.Uuid
  vendorName       String    @map("vendor_name") @db.VarChar(255)
  invoiceNumber    String    @map("invoice_number") @db.VarChar(100)
  amountClaimed    Decimal   @map("amount_claimed") @db.Decimal(15, 2)
  receiptFileUrl   String    @map("receipt_file_url") @db.VarChar(500)
  verified         Boolean   @default(false)
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  disbursement   MilestoneDisbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  verifiedByUser User?                 @relation("UtilizationVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([disbursementId])
  @@index([verifiedByUserId])
  @@map("utilization_proofs")
  @@schema("finance")
}

model CampaignEndorsement {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @map("campaign_id") @db.Uuid
  endorserUserId String            @map("endorser_user_id") @db.Uuid
  designation    String            @db.VarChar(150)
  status         EndorsementStatus @default(PENDING)
  comments       String?           @db.Text
  endorsedAt     DateTime?         @map("endorsed_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  endorser User     @relation("UserCampaignEndorsements", fields: [endorserUserId], references: [id], onDelete: Restrict)

  @@unique([campaignId, endorserUserId])
  @@index([campaignId])
  @@index([endorserUserId])
  @@map("campaign_endorsements")
  @@schema("campaigns")
}

model CampaignMilestoneRevision {
  id             String @id @default(uuid()) @db.Uuid
  milestoneId    String @map("milestone_id") @db.Uuid
  revisionNumber Int    @map("revision_number") // 1, 2, 3 ...

  // Strongly-typed snapshot of milestone state
  title        String  @db.VarChar(255)
  description  String? @db.Text
  targetAmount Decimal @map("target_amount") @db.Decimal(15, 2)

  // Governance & Review
  changeReason String @map("change_reason") @db.Text
  status       String @default("APPROVED") @db.VarChar(50) // PENDING_APPROVAL, APPROVED, REJECTED

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason   String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  milestone   CampaignMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  requestedBy User              @relation("MilestoneRevisionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?             @relation("MilestoneRevisionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([milestoneId, revisionNumber])
  @@index([milestoneId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("campaign_milestone_revisions")
  @@schema("campaigns")
}

model CampaignMember {
  id         String             @id @default(uuid()) @db.Uuid
  campaignId String             @map("campaign_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  role       CampaignMemberRole @default(MEMBER)
  title      String?            @db.VarChar(100)
  invitedBy  String?            @map("invited_by") @db.Uuid
  joinedAt   DateTime           @default(now()) @map("joined_at") @db.Timestamptz
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User               @relation("CampaignMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_members")
  @@schema("campaigns")
}

model CampaignComment {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  parentId   String?           @map("parent_id") @db.Uuid
  content    String            @db.Text
  reported   Boolean           @default(false)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User              @relation("UserCampaignComments", fields: [userId], references: [id], onDelete: Cascade)
  parent     CampaignComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    CampaignComment[] @relation("CommentReplies")

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([userId])
  @@map("campaign_comments")
  @@schema("campaigns")
}

