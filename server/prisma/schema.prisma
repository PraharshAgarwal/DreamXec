model GrantMilestone {
  id               String    @id @default(uuid()) @db.Uuid
  proposalId       String    @map("proposal_id") @db.Uuid
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  amount           Decimal   @db.Decimal(15, 2)
  status           String    @default("PENDING") @db.VarChar(50)
  evidenceMetadata Json      @default("{}") @map("evidence_metadata")
  disbursedAt      DateTime? @map("disbursed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  proposal GrantProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("grant_milestones")
  @@schema("finance")
}

// ============================================================================
// 8. DOCUMENTS REGISTRY SCHEMA (documents.*)
// ============================================================================

model Document {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  uploaderId       String    @map("uploader_id") @db.Uuid
  name             String    @db.VarChar(255)
  storageProvider  String    @default("S3") @map("storage_provider") @db.VarChar(50)
  storageKey       String    @map("storage_key") @db.VarChar(500)
  mimeType         String    @map("mime_type") @db.VarChar(100)
  fileSizeBytes    BigInt    @map("file_size_bytes")
  version          Int       @default(1)
  parentDocumentId String?   @map("parent_document_id") @db.Uuid
  isLatest         Boolean   @default(true) @map("is_latest")
  ocrStatus        String    @default("PENDING") @map("ocr_status") @db.VarChar(50)
  ocrText          String?   @map("ocr_text") @db.Text
  virusScanStatus  String    @default("PENDING") @map("virus_scan_status") @db.VarChar(50)
  retentionPolicy  String    @default("STANDARD") @map("retention_policy") @db.VarChar(50)
  retentionExpiry  DateTime? @map("retention_expiry") @db.Timestamptz
