generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["identity", "organization", "workflow", "verification", "finance", "payments", "documents", "notifications", "audit", "search", "jobs", "campaigns", "doc_vault", "account_vault"]
}

// ============================================================================
// 1. IDENTITY DOMAIN SCHEMA (identity.*)
// ============================================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("identity")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("identity")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN

  @@schema("identity")
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  username        String?       @unique @db.VarChar(60)
  email           String        @unique
  secondaryEmail  String?       @map("secondary_email")
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  fullName        String        @map("full_name") @db.VarChar(255)
  role            Role          @default(USER)
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")
  profileMetadata Json          @default("{}") @map("profile_metadata")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  speciesId                    String?                       @map("species_id") @db.Uuid
  speciesNumber                Int?                          @map("species_number")
  assignedSpecies              EndangeredSpecies?            @relation("UserAssignedSpecies", fields: [speciesId], references: [id], onDelete: SetNull)

  // Relations
  sessions                     Session[]
  memberships                  Membership[]
  donations                    Donation[]
  proposals                    GrantProposal[]
  documents                    Document[]
  applicantInstances           WorkflowInstance[]            @relation("ApplicantInstances")
  submittedStageSubmissions    StageSubmission[]             @relation("SubmittedStageSubmissions")
  executedStageExecutions      StageExecution[]              @relation("ExecutedStageExecutions")
  studentCampaigns             Campaign[]                    @relation("StudentCampaigns")
  beneficiaryCampaigns         Campaign[]                    @relation("BeneficiaryCampaigns")
  verifiedCampaigns            Campaign[]                    @relation("VerifiedCampaigns")
  campaignEndorsements         CampaignEndorsement[]         @relation("UserCampaignEndorsements")
  campaignMemberships          CampaignMember[]              @relation("CampaignMemberships")
  campaignComments             CampaignComment[]             @relation("UserCampaignComments")
  reviewedMilestoneSubmissions CampaignMilestoneSubmission[] @relation("ReviewedMilestoneSubmissions")
  requestedMilestoneRevisions  CampaignMilestoneRevision[]   @relation("MilestoneRevisionRequestedBy")
  reviewedMilestoneRevisions   CampaignMilestoneRevision[]   @relation("MilestoneRevisionReviewedBy")
  docVaultItems                UserDocVault[]                @relation("UserDocVaultItems")
  accountVaultItems            UserAccountVault[]            @relation("UserAccountVaultItems")
  disbursementsMade            MilestoneDisbursement[]       @relation("DisbursementMaker")
  disbursementsChecked         MilestoneDisbursement[]       @relation("DisbursementChecker")
  utilizationsVerified         UtilizationProof[]            @relation("UtilizationVerifier")
  ledgerAccounts               LedgerAccount[]
  ledgerTransactions           LedgerTransaction[]
  withdrawalRequests           WithdrawalRequest[]           @relation("UserWithdrawals")

  apaarId                      String?                       @unique @map("apaar_id") @db.VarChar(20)
  isKycVerified                Boolean                       @default(false) @map("is_kyc_verified")
  kycVerifiedAt                DateTime?                     @map("kyc_verified_at") @db.Timestamptz

  @@unique([speciesId, speciesNumber])
  @@index([speciesId])
  @@map("users")
  @@schema("identity")
}

model EndangeredSpecies {
  id              String   @id @default(uuid()) @db.Uuid
  commonName      String   @unique @map("common_name") @db.VarChar(150)
  scientificName  String?  @map("scientific_name") @db.VarChar(200)
  slug            String   @unique @db.VarChar(100)
  taxonomicGroup  String   @default("MAMMAL") @map("taxonomic_group") @db.VarChar(50)
  category        String   @default("CRITICALLY_ENDANGERED") @db.VarChar(50)
  estimatedCount  Int      @default(100) @map("estimated_count")
  assignedCount   Int      @default(0) @map("assigned_count")
  avatarUrl       String   @map("avatar_url") @db.VarChar(500)
  thumbnailUrl    String?  @map("thumbnail_url") @db.VarChar(500)
  habitat         String?  @db.VarChar(255)
  region          String?  @db.VarChar(150)
  iucnId          String?  @map("iucn_id") @db.VarChar(50)
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  users           User[]   @relation("UserAssignedSpecies")

  @@index([isActive, assignedCount])
  @@index([category])
  @@map("endangered_species")
  @@schema("identity")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  category    String   @default("GENERAL") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role          String   @db.VarChar(50)
  permissionKey String   @map("permission_key") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([role, permissionKey])
  @@map("role_permissions")
  @@schema("identity")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  accessTokenHash  String        @unique @map("access_token_hash") @db.VarChar(255)
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(255)
  activeTenantId   String?       @map("active_tenant_id") @db.Uuid
  deviceInfo       Json          @default("{}") @map("device_info")
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@map("sessions")
  @@schema("identity")
}

// ============================================================================
// 2. ORGANIZATION DOMAIN SCHEMA (organization.*)
// ============================================================================

enum LifecycleStatus {
  DRAFT
  SUBMITTED
  PENDING_VERIFICATION
  VERIFICATION_REQUESTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  ARCHIVED
  MERGED
  DELETED

  @@schema("organization")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED

  @@schema("organization")
}

enum OrgRole {
  STUDENT
  ORG_ADMIN
  PROFESSOR
  RESEARCHER
  MENTOR
  INCUBATOR_MANAGER
  COMPLIANCE_OFFICER
  FINANCE_OFFICER
  GRANT_OFFICER
  GOV_OFFICER
  GOV_OFFICIAL
  STUDENT_PRESIDENT
  CORPORATE_ADMIN
  DONOR
  SPONSOR
  ALUMNI
  CSR_MANAGER
  CORPORATE_RECRUITER
  VOLUNTEER
  PROGRAM_MANAGER
  EXTERNAL_ORG_MEMBER

  @@schema("organization")
}

enum OrgType {
  COLLEGE
  CLUB
  RESEARCH_INSTITUTION
  CORPORATE
  INCUBATOR
  NGO
  GOVERNMENT_BODY

  @@schema("organization")
}

model Organization {
  id              String          @id @default(uuid()) @db.Uuid
  parentId        String?         @map("parent_id") @db.Uuid
  ancestorId      String?         @map("ancestor_id") @db.Uuid
  depth           Int             @default(0)
  hierarchyPath   String          @map("hierarchy_path") // ltree mapped as String
  name            String          @db.VarChar(255)
  slug            String          @unique @db.VarChar(100)
  orgType         OrgType         @map("org_type")
  allowedRoles    OrgRole[]       @default([]) @map("allowed_roles")
  lifecycleStatus LifecycleStatus @default(DRAFT) @map("lifecycle_status")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz

  // Self relation
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrgHierarchy")

  // Relations
  sessions            Session[]
  memberships         Membership[]
  workflowTemplates   WorkflowTemplate[]
  workflowInstances   WorkflowInstance[]
  verifications       Verification[]
  ledgerAccounts      LedgerAccount[]
  ledgerTransactions  LedgerTransaction[]
  donations           Donation[]             @relation("TenantDonations")
  receivedDonations   Donation[]             @relation("ReceivedDonations")
  paymentIntents      PaymentIntent[]
  documents           Document[]
  notifications       NotificationHistory[]
  dashboard           OrganizationDashboard?
  grants              Grant[]
  grantProposals      GrantProposal[]
  tenantCampaigns     Campaign[]             @relation("TenantCampaigns")
  departmentCampaigns Campaign[]             @relation("DepartmentCampaigns")
  tenantWithdrawals   WithdrawalRequest[]    @relation("TenantWithdrawals")

  @@index([hierarchyPath])
  @@index([parentId])
  @@index([ancestorId])
  @@index([depth])
  @@index([lifecycleStatus])
  @@map("organizations")
  @@schema("organization")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrgRole          @default(RESEARCHER)
  designation    String?          @db.VarChar(150)
  department     String?          @db.VarChar(150)
  status         MembershipStatus @default(PENDING)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz
  invitedBy      String?          @map("invited_by") @db.Uuid
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("memberships")
  @@schema("organization")
}

// ============================================================================
// 3. WORKFLOW ENGINE DOMAIN SCHEMA (workflow.*)
// ============================================================================

enum StageType {
  FORM
  SUBMISSION
  EMAIL_VERIFICATION
  OTP_VERIFICATION
  DOCUMENT_UPLOAD
  DOCUMENT_VERIFICATION
  BACKGROUND_CHECK
  API_VALIDATION
  AUTOMATED_CHECK
  MANUAL_REVIEW
  MANUAL_APPROVAL
  FRAUD_CHECK
  COMPLIANCE_REVIEW
  APPROVAL
  REJECTION
  PAYMENT
  EMAIL_NOTIFICATION
  WEBHOOK
  SYSTEM_TASK
  COMPLETE
  APAAR_VERIFICATION
  ORCID_VERIFICATION

  @@schema("workflow")
}

enum ExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED

  @@schema("workflow")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("workflow")
}

enum InstanceStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED

  @@schema("workflow")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED

  @@schema("workflow")
}

model WorkflowTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String         @db.VarChar(255)
  slug        String         @db.VarChar(100)
  description String?        @db.Text
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz

  organization Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages       WorkflowStage[]
  instances    WorkflowInstance[]

  @@unique([tenantId, slug, version])
  @@index([tenantId, status])
  @@map("workflow_templates")
  @@schema("workflow")
}

model WorkflowStage {
  id             String    @id @default(uuid()) @db.Uuid
  templateId     String    @map("template_id") @db.Uuid
  name           String    @db.VarChar(150)
  description    String?   @db.Text
  stageType      StageType @map("stage_type")
  executionOrder Int       @map("execution_order")
  config         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  template         WorkflowTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  currentInstances WorkflowInstance[] @relation("CurrentStage")
  submissions      StageSubmission[]
  executions       StageExecution[]

  @@unique([templateId, executionOrder])
  @@index([templateId, executionOrder])
  @@map("workflow_stages")
  @@schema("workflow")
}

model WorkflowInstance {
  id             String         @id @default(uuid()) @db.Uuid
  templateId     String         @map("template_id") @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  applicantId    String?        @map("applicant_id") @db.Uuid
  applicantEmail String         @map("applicant_email")
  applicantName  String         @map("applicant_name") @db.VarChar(255)
  orgType        String         @map("org_type") @db.VarChar(100)
  status         InstanceStatus @default(IN_PROGRESS)
  currentStageId String?        @map("current_stage_id") @db.Uuid
  instanceData   Json           @default("{}") @map("instance_data")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz

  template      WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization  Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant     User?             @relation("ApplicantInstances", fields: [applicantId], references: [id], onDelete: SetNull)
  currentStage  WorkflowStage?    @relation("CurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  submissions   StageSubmission[]
  executions    StageExecution[]
  verifications Verification[]

  @@index([tenantId, status])
  @@index([applicantId])
  @@index([templateId])
  @@index([applicantEmail, status])
  @@index([tenantId, currentStageId])
  @@index([tenantId, applicantEmail, status])
  @@index([tenantId, applicantId, status])
  @@map("workflow_instances")
  @@schema("workflow")
}

model StageSubmission {
  id                 String           @id @default(uuid()) @db.Uuid
  workflowInstanceId String           @map("workflow_instance_id") @db.Uuid
  workflowStageId    String           @map("workflow_stage_id") @db.Uuid
  submittedById      String?          @map("submitted_by_id") @db.Uuid
  status             SubmissionStatus @default(SUBMITTED)
  version            Int              @default(1)
  formData           Json             @default("{}") @map("form_data")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStage    WorkflowStage    @relation(fields: [workflowStageId], references: [id], onDelete: Restrict)
  submittedBy      User?            @relation("SubmittedStageSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([workflowInstanceId, workflowStageId])
  @@index([workflowInstanceId, createdAt(sort: Asc)])
  @@index([submittedById])
  @@index([status])
  @@map("stage_submissions")
  @@schema("workflow")
}

model StageExecution {
  id                 String  @id @default(uuid()) @db.Uuid
  workflowInstanceId String  @map("workflow_instance_id") @db.Uuid
  workflowStageId    String? @map("workflow_stage_id") @db.Uuid
  executedById       String? @map("executed_by_id") @db.Uuid

  // Immutable Audit Snapshots
  stageName      String    @map("stage_name") @db.VarChar(150)
  stageType      StageType @map("stage_type")
  executionOrder Int       @map("execution_order")

  executionStatus ExecutionStatus @default(PENDING) @map("execution_status")
  attempt         Int             @default(1)
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz
  durationMs      Int?            @map("duration_ms")
  metadata        Json            @default("{}")
  errorMessage    String?         @map("error_message") @db.Text

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStage    WorkflowStage?   @relation(fields: [workflowStageId], references: [id], onDelete: SetNull)
  executedBy       User?            @relation("ExecutedStageExecutions", fields: [executedById], references: [id], onDelete: SetNull)

  @@index([workflowInstanceId, startedAt])
  @@index([executionStatus])
  @@index([executedById])
  @@map("stage_executions")
  @@schema("workflow")
}

// ============================================================================
// 4. VERIFICATION PIPELINE DOMAIN SCHEMA (verification.*)
// ============================================================================

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED

  @@schema("verification")
}

model Verification {
  id                 String             @id @default(uuid()) @db.Uuid
  instanceId         String?            @map("instance_id") @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  verificationType   String             @map("verification_type") @db.VarChar(100)
  status             VerificationStatus @default(PENDING)
  evidenceUrl        String?            @map("evidence_url") @db.VarChar(500)
  verificationData   Json               @default("{}") @map("verification_data")
  assignedOrgAdminId String?            @map("assigned_org_admin_id") @db.Uuid
  notificationSentAt DateTime?          @map("notification_sent_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz

  instance     WorkflowInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("verifications")
  @@schema("verification")
}

// ============================================================================
// 5. FINANCE (DOUBLE-ENTRY LEDGER & WALLET) SCHEMA (finance.*)
// ============================================================================

enum LedgerScopeType {
  SYSTEM
  USER
  ORGANIZATION

  @@schema("finance")
}

enum LedgerOwnerType {
  SYSTEM
  USER
  ORGANIZATION
  CAMPAIGN

  @@schema("finance")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE

  @@schema("finance")
}

enum LedgerEntryType {
  DEBIT
  CREDIT

  @@schema("finance")
}

enum LedgerTransactionStatus {
  POSTED
  VOID
  REVERSED

  @@schema("finance")
}

model LedgerAccount {
  id              String            @id @default(uuid()) @db.Uuid
  scopeType       LedgerScopeType   @default(SYSTEM) @map("scope_type")
  tenantId        String?           @map("tenant_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  accountNumber   String?           @map("account_number") @db.VarChar(50)
  name            String            @db.VarChar(255)
  description     String?           @db.Text
  accountType     LedgerAccountType @default(ASSET) @map("account_type")
  currency        String            @default("INR") @db.VarChar(3)
  balanceCached   Decimal           @default(0.0000) @map("balance_cached") @db.Decimal(18, 4)
  ownerType       LedgerOwnerType?  @map("owner_type")
  ownerId         String?           @map("owner_id") @db.Uuid
  parentAccountId String?           @map("parent_account_id") @db.Uuid
  metadata        Json              @default("{}")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz

  organization  Organization?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentAccount LedgerAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts LedgerAccount[] @relation("AccountHierarchy")
  entries       LedgerEntry[]
  campaign      Campaign?

  @@unique([tenantId, name, currency])
  @@index([scopeType, userId])
  @@index([tenantId, accountType])
  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
  @@schema("finance")
}

model LedgerTransaction {
  id              String                  @id @default(uuid()) @db.Uuid
  scopeType       LedgerScopeType         @default(SYSTEM) @map("scope_type")
  tenantId        String?                 @map("tenant_id") @db.Uuid
  userId          String?                 @map("user_id") @db.Uuid
  transactionType String                  @map("transaction_type") @db.VarChar(100)
  referenceType   String                  @map("reference_type") @db.VarChar(100)
  referenceId     String                  @map("reference_id") @db.Uuid
  idempotencyKey  String?                 @unique @map("idempotency_key") @db.VarChar(255)
  status          LedgerTransactionStatus @default(POSTED)
  currency        String                  @default("INR") @db.VarChar(3)
  reversalOfId    String?                 @unique @map("reversal_of_id") @db.Uuid
  metadata        Json                    @default("{}")
  postedAt        DateTime                @default(now()) @map("posted_at") @db.Timestamptz
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz

  organization Organization?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  reversalOf   LedgerTransaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy   LedgerTransaction? @relation("TransactionReversal")
  entries      LedgerEntry[]

  @@unique([referenceType, referenceId, transactionType])
  @@index([tenantId, referenceType, referenceId])
  @@index([scopeType, userId])
  @@index([transactionType, postedAt(sort: Desc)])
  @@map("ledger_transactions")
  @@schema("finance")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  amount        Decimal         @db.Decimal(18, 4)
  entryType     LedgerEntryType @map("entry_type")
  currency      String          @default("INR") @db.VarChar(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("ledger_entries")
  @@schema("finance")
}

// ============================================================================
// 6. PAYMENTS DOMAIN SCHEMA (payments.*)
// ============================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED

  @@schema("payments")
}

model Donation {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  donorId          String?   @map("donor_id") @db.Uuid
  recipientOrgId   String?   @map("recipient_org_id") @db.Uuid
  campaignId       String?   @map("campaign_id") @db.Uuid
  amount           Decimal   @db.Decimal(15, 2)
  currency         String    @default("INR") @db.VarChar(3)
  isAnonymous      Boolean   @default(false) @map("is_anonymous")
  donorDisplayName String?   @map("donor_display_name") @db.VarChar(150)
  donorMessage     String?   @map("donor_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  organization   Organization?   @relation("TenantDonations", fields: [tenantId], references: [id], onDelete: SetNull)
  recipient      Organization?   @relation("ReceivedDonations", fields: [recipientOrgId], references: [id], onDelete: SetNull)
  donor          User?           @relation(fields: [donorId], references: [id], onDelete: SetNull)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]

  @@index([createdAt(sort: Desc)])
  @@index([campaignId])
  @@index([donorId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([recipientOrgId])
  @@map("donations")
  @@schema("payments")
}

model PaymentIntent {
  id             String        @id @default(uuid()) @db.Uuid
  donationId     String        @map("donation_id") @db.Uuid
  tenantId       String?       @map("tenant_id") @db.Uuid
  totalAmount    Decimal       @map("total_amount") @db.Decimal(15, 2)
  currency       String        @default("INR") @db.VarChar(3)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(255)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  donation     Donation         @relation(fields: [donationId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  attempts     PaymentAttempt[]
  refunds      Refund[]

  @@index([donationId])
  @@index([status])
  @@map("payment_intents")
  @@schema("payments")
}

model PaymentAttempt {
  id                   String        @id @default(uuid()) @db.Uuid
  paymentIntentId      String        @map("payment_intent_id") @db.Uuid
  gateway              String        @db.VarChar(50)
  gatewayTransactionId String?       @map("gateway_transaction_id") @db.VarChar(255)
  gatewayPaymentId     String?       @map("gateway_payment_id") @db.VarChar(255)
  gatewayOrderId       String?       @map("gateway_order_id") @db.VarChar(255)
  gatewaySignature     String?       @map("gateway_signature") @db.VarChar(500)
  status               PaymentStatus @default(PENDING)
  errorMessage         String?       @map("error_message") @db.Text
  rawResponse          Json?         @default("{}") @map("raw_response")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  intent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([gatewayTransactionId])
  @@index([gatewayPaymentId])
  @@index([paymentIntentId])
  @@map("payment_attempts")
  @@schema("payments")
}

model Refund {
  id              String        @id @default(uuid()) @db.Uuid
  paymentIntentId String        @map("payment_intent_id") @db.Uuid
  amount          Decimal       @db.Decimal(15, 2)
  status          PaymentStatus @default(PENDING)
  gatewayRefundId String?       @map("gateway_refund_id") @db.VarChar(255)
  reason          String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  intent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@map("refunds")
  @@schema("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  gateway     String    @db.VarChar(50)
  payload     Json
  status      String    @default("UNPROCESSED") @db.VarChar(50)
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("webhook_events")
  @@schema("payments")
}

