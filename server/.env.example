# ==============================================================================
# DreamXec Environment Variables Template
# ==============================================================================

# Node Environment & Server Port
NODE_ENV="production"
PORT=5000

# Client & CORS URL (Frontend origin, supports comma-separated values)
CLIENT_URL="https://dreamxec.com"
CORS_ALLOWED_ORIGINS="https://dreamxec.com,https://d123456.cloudfront.net,http://localhost:5173"

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Direct or connection pooled connection URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection Pool & Timeout Controls (Dynamically injected into Prisma)
DB_CONNECTION_LIMIT=25
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
PRISMA_QUERY_LOGS="false"

# ------------------------------------------------------------------------------
# 2. SERVER TIMEOUTS & NETWORK BUFFERING
# ------------------------------------------------------------------------------
# ALB / Nginx keep-alive timeout (must exceed ALB default 60s idle timeout to prevent 502s)
SERVER_KEEP_ALIVE_TIMEOUT=65000
SERVER_HEADERS_TIMEOUT=66000
BODY_PARSER_LIMIT="15mb"

# Session Management
SESSION_NAME="dreamxec.sid"
SESSION_SECRET="your-secure-random-session-secret"
SESSION_MAX_AGE_MS=86400000
USE_REDIS_SESSION="false"

# ------------------------------------------------------------------------------
# 3. CACHE & MEMORY BUFFER THRESHOLDS
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379"
# Optional: override the default Redis Hash key (defaults to "dreamxec:env")
# REDIS_ENV_KEY="dreamxec:env"

# In-Memory L1 Caching Controls
CACHE_MAX_L1_ENTRIES=2000
CACHE_L1_MAX_TTL_SECONDS=60
AUTH_MAX_L1_ENTRIES=5000
AUTH_L1_CACHE_TTL_MS=60000

# ------------------------------------------------------------------------------
# 4. RATE LIMITING CONTROLS
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_OTP_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_PAYMENT_MAX=30
RATE_LIMIT_PAYMENT_WINDOW_MS=60000     # 1 minute
RATE_LIMIT_COMMENTS_MAX=5
RATE_LIMIT_COMMENTS_WINDOW_SEC=60      # 1 minute

# ------------------------------------------------------------------------------
# 5. AWS S3 STORAGE & CLOUDFRONT CDN
# ------------------------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="dreamxec-uploads"
# Optional if running in AWS EC2 with IAM Instance Profile; required if using IAM User keys
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
# CloudFront CDN distribution serving uploaded media from S3 with global low latency
CLOUDFRONT_URL="https://d12345678.cloudfront.net"

# ------------------------------------------------------------------------------
# 6. GITHUB ACTIONS CD SECRETS (For CI/CD AWS Deployment)
# ------------------------------------------------------------------------------
# AWS_ROLE_ARN or (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY)
# AWS_ECR_REPOSITORY="dreamxec-backend"
# AWS_EC2_INSTANCE_ID="i-0xxxxxxxxxxxx"
# AWS_ACCOUNT_ID="123456789012"

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (Razorpay PG) & RAZORPAYX PAYOUTS
# ------------------------------------------------------------------------------
# Primary / Default Gateway Keys (Fallback for local dev or Domain 1)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Multi-Domain Setup: Host same backend for 2 different domains with different Razorpay accounts
# Domain 1 (e.g. dreamxec.com)
DOMAIN_1="dreamxec.com"
RAZORPAY_KEY_ID_1="rzp_live_..."
RAZORPAY_KEY_SECRET_1="..."
RAZORPAY_WEBHOOK_SECRET_1="..."

# Domain 2 (e.g. yourseconddomain.com)
DOMAIN_2="yourseconddomain.com"
RAZORPAY_KEY_ID_2="rzp_live_..."
RAZORPAY_KEY_SECRET_2="..."
RAZORPAY_WEBHOOK_SECRET_2="..."

# RazorpayX (Disbursements & Bank Payouts for Researcher Withdrawals)
RAZORPAYX_KEY_ID="rzp_test_..."
RAZORPAYX_KEY_SECRET="..."
RAZORPAYX_ACCOUNT_NUMBER="787878..."
RAZORPAYX_WEBHOOK_SECRET="..."
RAZORPAYX_SIMULATION="false"
RAZORPAYX_PAYOUT_MODE="IMPS"
